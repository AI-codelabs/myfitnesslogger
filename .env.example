# Copy to .env.local for local development. Never commit real secrets.

# Neon project: coaching-platform (fragrant-queen-24129188, aws-eu-central-1)
# Create/rotate keys in the Neon console. Prefer pooled DATABASE_URL for serverless.

NEON_PROJECT_ID=fragrant-queen-24129188
NEON_BRANCH_ID=br-nameless-unit-b1jeijpa
NEON_ENDPOINT_ID=ep-winter-sky-b1m35c4c

DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-winter-sky-b1m35c4c-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://neondb_owner:PASSWORD@ep-winter-sky-b1m35c4c.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_URL=https://ep-winter-sky-b1m35c4c.neonauth.c-5.eu-central-1.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://ep-winter-sky-b1m35c4c.neonauth.c-5.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-winter-sky-b1m35c4c.neonauth.c-5.eu-central-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://ep-winter-sky-b1m35c4c.neonauth.c-5.eu-central-1.aws.neon.tech
# Optional — only shown once when Auth is enabled in console/API
NEON_AUTH_PUB_CLIENT_KEY=
NEON_AUTH_SECRET_SERVER_KEY=

# Feature routing (comma-separated). Empty = legacy paths where still gated.
VITE_NEON_FEATURES=weight,checkins,workouts,nutrition,clients,functions

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173

# Optional legacy fallbacks during migration (remove when unused)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=
# LEGACY_AUTH_URL=

# Vercel Blob / integrations (set on Vercel for Preview/Production)
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=
# ADMIN_API_SECRET=
