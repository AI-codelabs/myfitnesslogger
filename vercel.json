{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/neon-auth/:path*",
      "destination": "https://ep-super-butterfly-b1u1cypj.neonauth.c-5.eu-central-1.aws.neon.tech/neondb/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__route=:path*"
    },
    {
      "source": "/((?!api/|neon-auth/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cronometer-pull",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/check-expirations",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/email/send-checkin-reminders?mode=sunday",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/email/send-checkin-reminders?mode=monday",
      "schedule": "0 8 * * 1"
    }
  ]
}
